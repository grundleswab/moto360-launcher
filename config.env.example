# Copy this file to ~/.config/moto360-launcher/env and fill in your values.
# The repository itself contains no device addresses, paths, or credentials.
# Shell scripts source this file; the Python daemon reads the same KEY=VALUE
# format. Values present here are applied on startup; omit a variable to keep
# its default or a value supplied by the environment.

# --- Devices ---------------------------------------------------------------
# Android phone reachable by adb (WiFi address:port, or a USB serial).
# Required by host/watch_bridge.sh and host/watch_link_monitor.sh.
MOTO360_PHONE=
# Optional USB serial used to restart the phone's WiFi ADB listener.
MOTO360_PHONE_USB=
# Port used by `adb tcpip` on the phone; defaults to the port in MOTO360_PHONE.
MOTO360_PHONE_TCP_PORT=

# --- Host bridge -----------------------------------------------------------
MOTO360_HOST=127.0.0.1
MOTO360_PORT=9999
MOTO360_WATCH_FORWARD_PORT=4444
MOTO360_POLL_SECONDS=2
MOTO360_MONITOR_INTERVAL=20

# --- Desktop integration (Omarchy/Hyprland defaults) -----------------------
MOTO360_WORKSPACES=5
MOTO360_WORKSPACE_BLOCK=10
MOTO360_WORKSPACE_LUA='require("default.hypr.monitor-workspaces").focus(%d)()'
MOTO360_FOCUS_DISPATCH='hl.dsp.window.cycle_next()'
MOTO360_CLOSE_DISPATCH='hl.dsp.window.close()'
MOTO360_HYPRCTL=hyprctl

# --- Android app identity --------------------------------------------------
MOTO360_PHONE_PKG=com.example.omarchy.watch
MOTO360_BRIDGE_ACTIVITY=com.example.omarchy.watch/com.example.omarchy.phone.MainActivity

# --- Logs and tool locations ----------------------------------------------
# Default logs go under ${XDG_STATE_HOME:-$HOME/.local/state}/moto360-launcher/.
# MOTO360_DAEMON_LOG=
# MOTO360_MONITOR_LOG=
# MOTO360_DAEMON=/path/to/omarchy_watch_daemon.py
# ADB=adb
# SS=ss
# PYTHON=python3
# TIMEOUT=timeout

# --- Build toolchain -------------------------------------------------------
# ANDROID_SDK_ROOT=/path/to/android-sdk
# ANDROID_HOME=/path/to/android-sdk
# ANDROID_BUILD_TOOLS=30.0.3
# JAVA_HOME=/path/to/jdk-17
# AARS_DIR=/path/to/extracted/aars
# AAR_LIST="play-services-wearable-8.4.0 play-services-base-8.4.0 ..."
# MOTO360_KEYSTORE=$HOME/.local/share/moto360-launcher/debug.keystore
